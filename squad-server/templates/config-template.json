      }
    ]
  },
  "layers": {
    "sources": [
      {
        "name": "Squad",
        "url": "https://raw.githubusercontent.com/fantinodavide/SquadLayerList/main/layers.json"
      },
      {
        "name": "Steel Division",
        "url": "https://raw.githubusercontent.com/fantinodavide/SquadLayerList/main/mods/steel-division/layers.json"
      },
      {
        "name": "King of the Hill",
        "url": "https://raw.githubusercontent.com/fantinodavide/SquadLayerList/main/mods/koth/layers.json"
      },
      {
        "name": "SuperMod",
        "url": "https://raw.githubusercontent.com/fantinodavide/SquadLayerList/main/mods/supermod/layers.json"
      },
      {
