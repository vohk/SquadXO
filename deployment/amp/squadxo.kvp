Meta.DisplayName=SquadXO
Meta.Description=SquadXO public release deployment (Linux, Node.js 24 required)
Meta.OS=Linux
Meta.Arch=All
Meta.Author=SquadXO contributors
Meta.URL=https://github.com/vohk/SquadXO
Meta.ConfigManifest=squadxoconfig.json
Meta.MetaConfigManifest=squadxometaconfig.json
Meta.ConfigRoot=squadxo.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=Install Node.js 24 and npm inside the instance environment before updating.
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=1
Meta.AppConfigId=9a8bb629-550b-494a-98ef-4cce021b31bb
App.DisplayName=SquadXO
App.RootDir=./squadxo/
App.BaseDirectory=./squadxo/
App.ExecutableLinux={{NodeExecutable}}
App.WorkingDir=./
App.CommandLineArgs=--unhandled-rejections=warn index.js --config config.json
App.EnvironmentVariables={}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.Ports=@IncludeJson[squadxoports.json]
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[squadxoupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.SmartExcludeSupported=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^SquadXO runtime started\.
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Limits.SleepMode=False
